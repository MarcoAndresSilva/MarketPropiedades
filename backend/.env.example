# Copiar a .env y completar. .env nunca se commitea.

# Local: Postgres de docker-compose (raíz del repo, `docker compose up -d`).
# Producción (Neon): DATABASE_URL pooled (runtime) y DIRECT_URL directa (Prisma Migrate).
DATABASE_URL="postgresql://market:market@localhost:5434/market_propiedades?schema=public"
DIRECT_URL="postgresql://market:market@localhost:5434/market_propiedades?schema=public"

NODE_ENV=development
PORT=3002

# URL del frontend, para configurar CORS.
FRONTEND_URL="http://localhost:4202"
