# Copiar a .env y completar. .env nunca se commitea.

# Local: Postgres de docker-compose (raíz del repo, `docker compose up -d`).
# Producción (Neon): DATABASE_URL pooled (runtime) y DIRECT_URL directa (Prisma Migrate).
DATABASE_URL="postgresql://market:market@localhost:5434/market_propiedades?schema=public"
DIRECT_URL="postgresql://market:market@localhost:5434/market_propiedades?schema=public"

NODE_ENV=development
PORT=3002

# URL del frontend, para configurar CORS.
FRONTEND_URL="http://localhost:4202"

# --- Auth del panel de administración ---

# Secreto para firmar los JWT (expiran a las 8h). En producción usar uno largo y
# aleatorio (ej. `openssl rand -base64 48`) y NUNCA reutilizar el de ejemplo.
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# Credenciales del admin. Las usa `npm run seed:admin` para crear/actualizar la cuenta.
# En producción setearlas en Render, sin commitear valores reales.
ADMIN_EMAIL="admin@marketpropiedades.cl"
ADMIN_PASSWORD="cambia-esta-contrasena-min-8-chars"
ADMIN_NAME="Administrador"
