// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// --- Ubicación (nacional, no hardcodeada a Melipilla) ---
// Sembrada desde datos oficiales SUBDERE (16 regiones, 346 comunas) — ver prisma/seed.ts.

model Region {
  id      Int      @id
  nombre  String   @unique
  comunas Comuna[]
}

model Comuna {
  id       String @id // código oficial SUBDERE de 5 dígitos, ej. "13101"
  nombre   String
  regionId Int
  region   Region @relation(fields: [regionId], references: [id])

  properties Property[]
  proyectos  Proyecto[]

  @@unique([nombre, regionId])
  @@index([regionId])
}

// --- Cuentas ---
// ADMIN: panel interno. PERSONA/CORREDORA: publicadores — confirmado con el socio que una
// corredora es UNA cuenta por agencia (no una por agente individual); sus agentes suben material
// bajo esa misma cuenta. El registro público todavía no existe (MVP curado, admin crea las cuentas
// a mano), pero el modelo ya soporta ambos tipos de publicador sin tener que rehacerse.

enum Role {
  ADMIN
  PERSONA // propietario particular
  CORREDORA
  INMOBILIARIA // desarrolla proyectos; publica propiedades y (más adelante) proyectos
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String
  name              String // nombre de contacto (persona) o nombre de la agencia (corredora)
  whatsapp          String? // formato E.164, ej. "+56912345678" — contacto de sus fichas, link wa.me
  role              Role      @default(ADMIN)
  // null = correo sin verificar. Lo llena el flujo de registro público de anunciantes.
  emailVerificadoAt DateTime?

  corredoraProfile CorredoraProfile?
  properties       Property[]
  proyectos        Proyecto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Datos propios de una agencia — solo existe cuando User.role = CORREDORA.
model CorredoraProfile {
  id          String  @id @default(cuid())
  userId      String  @unique
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  razonSocial String?
  rut         String? @unique
}

// --- Propiedades ---

enum TipoOperacion {
  VENTA
  ARRIENDO
}

enum TipoPropiedad {
  CASA
  DEPARTAMENTO
  PARCELA
  TERRENO
  OFICINA
  LOCAL_COMERCIAL
  BODEGA
}

enum EstadoPublicacion {
  BORRADOR
  PUBLICADA
  PAUSADA
  CERRADA // vendida o arrendada, según tipoOperacion
}

model Property {
  id     String            @id @default(cuid())
  slug   String            @unique
  estado EstadoPublicacion @default(BORRADOR)

  // Contacto de la ficha = el publicador dueño de la cuenta (User.name / User.whatsapp).
  // Admin sigue pudiendo cargar propiedades a nombre de cualquier cuenta durante el MVP curado.
  publicadorId String
  publicador   User   @relation(fields: [publicadorId], references: [id])

  // Título visible en cards y ficha ("Casa familiar con jardín en Peñaflor").
  titulo        String        @db.VarChar(120)
  tipoOperacion TipoOperacion
  tipoPropiedad TipoPropiedad
  destacada     Boolean       @default(false)

  comunaId  String
  comuna    Comuna  @relation(fields: [comunaId], references: [id])
  direccion String?
  lat       Float?
  lng       Float?

  // Precio tal como lo publicó el anunciante: venta normalmente en UF, arriendo en CLP;
  // una venta también puede venir en pesos (precioClp). Ver ARCHITECTURE.md.
  precioUf    Decimal? @db.Decimal(12, 2)
  precioClp   Int?
  // Solo ventas: el precio llevado a UF (el mismo precioUf, o precioClp / UF del día en
  // que se guardó). Lo usan el filtro de rango y el orden por precio para comparar
  // ventas publicadas en monedas distintas; nunca se muestra.
  precioRefUf Decimal? @db.Decimal(12, 2)

  m2Construidos    Float?
  m2Terreno        Float?
  dormitorios      Int?
  banos            Int?
  estacionamientos Int?
  bodegas          Int?
  gastosComunesClp Int?

  descripcion String

  videoUrl String?
  fotos    PropertyFoto[]

  consultas Consulta[]
  eventos   EventoPropiedad[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([comunaId])
  @@index([publicadorId])
  @@index([tipoOperacion, tipoPropiedad, estado])
  @@index([precioRefUf])
}

model PropertyFoto {
  id                 String   @id @default(cuid())
  propertyId         String
  property           Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  cloudinaryPublicId String
  orden              Int

  @@index([propertyId])
}

// Consulta enviada desde el formulario de la ficha. Se guarda siempre (aunque después
// se sume aviso por correo) para que ningún interesado se pierda si falla un envío.
model Consulta {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  nombre     String   @db.VarChar(100)
  email      String?  @db.VarChar(200)
  telefono   String?  @db.VarChar(30)
  mensaje    String   @db.VarChar(2000)
  leida      Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([propertyId, createdAt])
}

enum TipoEvento {
  VISTA
  CLIC_WHATSAPP
  FAVORITO
}

// Métricas básicas de una ficha. `visitante` es un id anónimo que genera el navegador
// (no identifica a nadie): sirve para no contar dos veces la misma vista del mismo
// visitante en el día. Las consultas se cuentan desde la tabla Consulta.
model EventoPropiedad {
  id         String     @id @default(cuid())
  propertyId String
  property   Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tipo       TipoEvento
  visitante  String     @db.VarChar(64)
  createdAt  DateTime   @default(now())

  @@index([propertyId, tipo])
  @@index([propertyId, tipo, visitante, createdAt])
}

enum EtapaProyecto {
  EN_PLANIFICACION
  EN_CONSTRUCCION
  ENTREGA_INMEDIATA
}

// Proyecto inmobiliario (edificio, condominio, loteo) que una corredora o inmobiliaria
// desarrolla en la zona. No es una Property: se vende por unidades con precio "desde" y
// rangos (dormitorios, baños, m²), y tiene una etapa de obra en vez de estar listo.
model Proyecto {
  id     String            @id @default(cuid())
  slug   String            @unique
  estado EstadoPublicacion @default(BORRADOR)

  publicadorId String
  publicador   User   @relation(fields: [publicadorId], references: [id])

  nombre      String        @db.VarChar(120)
  etapa       EtapaProyecto
  entrega     String?       @db.VarChar(60) // texto libre: "2º semestre 2027"
  destacado   Boolean       @default(false)
  comunaId    String
  comuna      Comuna        @relation(fields: [comunaId], references: [id])
  direccion   String?
  lat         Float?
  lng         Float?
  descripcion String

  precioDesdeUf  Decimal? @db.Decimal(12, 2)
  dormitoriosMin Int?
  dormitoriosMax Int?
  banosMin       Int?
  banosMax       Int?
  m2Min          Float?
  m2Max          Float?
  unidades       Int?

  fotos ProyectoFoto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([comunaId])
  @@index([publicadorId])
  @@index([estado, destacado])
}

model ProyectoFoto {
  id                 String   @id @default(cuid())
  proyectoId         String
  proyecto           Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  cloudinaryPublicId String
  orden              Int

  @@index([proyectoId])
}
